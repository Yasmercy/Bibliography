	title = {Evaluating local community methods in networks},
	volume = {2008},
	ISSN = {1742-5468},
	url = {http://dx.doi.org/10.1088/1742-5468/2008/05/P05001},
	DOI = {10.1088/1742-5468/2008/05/p05001},
